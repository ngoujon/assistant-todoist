{
  "name": "assistant-todoist",
  "productName": "Assistant Todoist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Assistant de planification qui pilote Todoist (Claude Agent SDK + MCP Todoist)",
  "author": "ngoujon",
  "main": "dist/src/main.js",
  "scripts": {
    "build:ts": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && cp src/renderer/index.html src/renderer/style.css dist/src/renderer/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build:ts && electron .",
    "test": "node scripts/impact-test.ts && node scripts/undo-test.ts",
    "selftest": "node scripts/selftest.ts",
    "preview": "npm run build:ts && electron dist/scripts/preview.js",
    "icon": "bash scripts/make-icon.sh",
    "build": "bash scripts/build-app.sh",
    "install-app": "bash scripts/install-app.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.0",
    "electron": "^44.0.0",
    "typescript": "^7.0.2"
  }
}
